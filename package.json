{
    "name": "lomi-server",
    "version": "0.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev:start": "docker-compose -f compose.yml -f compose.override.yml up --build",
        "dev:stop": "docker-compose -f compose.yml -f compose.override.yml down",
        "dev:stop-v": "docker-compose -f compose.yml -f compose.override.yml down -v",
        "dev:migration": "node -e \"const d=new Date();const f=d.toISOString().slice(0,19).replace('T','_').replace(/:/g,'-');require('fs').writeFileSync('./migrations/'+f+'.sql','');\"",
        "dev:setup": "docker-compose -f compose.yml -f compose.override.yml exec app npx ts-node -r tsconfig-paths/register src/setup.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MaxLehmann01/lomi-server.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/MaxLehmann01/lomi-server/issues"
    },
    "homepage": "https://github.com/MaxLehmann01/lomi-server#readme",
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.6.2",
        "@types/pg": "^8.20.0",
        "prettier": "^3.8.3",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.17",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.20.0",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    }
}
